{
  "services": {
    "frontend": { "root": "web/" },
    "backend": {
      "root": "server/",
      "entrypoint": "index:app",
      "installCommand": "rm -rf app && cp -r ../app ./app && pip install -r requirements.txt",
      "functions": {
        "index.py": { "regions": ["sin1"] }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
